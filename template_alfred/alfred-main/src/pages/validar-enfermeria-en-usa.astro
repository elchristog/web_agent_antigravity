      if (calcBtn && salaryInput && resultBox) {
        calcBtn.addEventListener('click', () => {
          const currentSalary = parseFloat(salaryInput.value) || 800;
          const avgUsaMonthlySalary = 6500;
          const multiplier = (avgUsaMonthlySalary / Math.max(currentSalary, 100)).toFixed(1);
          const leftOnTable = Math.max(avgUsaMonthlySalary - currentSalary, 0);

          usaSalaryText.textContent = `$${avgUsaMonthlySalary.toLocaleString()} USD / mes`;
          multiplierText.textContent = `${multiplier}x más ingresos`;
          leftOnTableText.textContent = `-$${leftOnTable.toLocaleString()} USD`;

          resultBox.classList.remove('hidden');
        });
      }
    });
  </script>

